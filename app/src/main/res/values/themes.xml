<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SportUtility" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_yellow</item>
        <item name="colorPrimaryVariant">@color/black</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/accent_yellow</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:colorBackground">@color/white</item>
        <item name="colorSurface">@color/white</item>
    </style>

    <style name="Theme.SportUtility.Splash" parent="Theme.SportUtility">
        <item name="android:windowBackground">@drawable/gradient_header</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="SpinnerStyle" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/spinner_background</item>
    </style>
</resources>
